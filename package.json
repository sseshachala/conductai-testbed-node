{
  "name": "conductai-testbed-node",
  "version": "1.0.0",
  "description": "Sample engineering team blog API built with Express and TypeScript",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "seed": "ts-node seed.ts",
    "test": "jest --forceExit --runInBand",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "better-sqlite3": "11.10.0",
    "express": "4.22.2",
    "jsonwebtoken": "9.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/express": "4.17.21",
    "@types/jest": "^29.5.0",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/node": "^20.0.0",
    "@types/supertest": "^2.0.12",
    "jest": "29.5.0",
    "supertest": "6.3.3",
    "ts-jest": "29.1.0",
    "ts-node": "10.9.1",
    "typescript": "5.0.4"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    }
  },
  "overrides": {
    "path-to-regexp": "0.1.13"
  }
}
